PORT=4173

# Yahoo!リアルタイム検索のランキングAPIは法人向け提供です。
# 契約済みの場合のみ、提供されたURLとキーを入れてください。
YAHOO_REALTIME_API_URL=
YAHOO_REALTIME_API_KEY=

# 公開RSS系の取得を止めたい場合は 1
DISABLE_LIVE=0

# note.comトップページから公開トピックらしき語を読む実験アダプタ。
# 規約・安定性の都合で標準は無効です。使う場合だけ 1 にしてください。
ENABLE_NOTE_PUBLIC_PAGE=0
NOTE_TREND_URL=https://note.com/
